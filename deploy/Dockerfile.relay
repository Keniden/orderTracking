FROM golang:1.25 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/outbox-relay ./cmd/outbox-relay

FROM gcr.io/distroless/base-debian12
WORKDIR /
COPY --from=build /out/outbox-relay /outbox-relay
USER 65532:65532
ENTRYPOINT ["/outbox-relay"]
